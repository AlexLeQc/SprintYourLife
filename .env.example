# Copy to `.env` and fill in. Never commit `.env` (NFR-06).
# See specs/001-foundation/tasks.md (T09, T11) for where each value comes from.

# Neon PostgreSQL — pooled connection string (`dev` branch locally)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in (ADR-0006)
ALLOWED_EMAILS=
